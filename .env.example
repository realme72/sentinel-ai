# --- Datastores (both run locally, no Docker) ---
# Postgres 18 (brew-linked; `psql` resolves to 18.x)
SENTINEL_PG_DSN=postgresql://localhost:5432/sentinel
SENTINEL_QDRANT_URL=http://localhost:6333

# --- Free enrichment feeds ---
# NVD API 2.0 key (free, instant): https://nvd.nist.gov/developers/request-an-api-key
# Without a key you are capped at 5 req / 30s instead of 50 req / 30s.
SENTINEL_NVD_API_KEY=
# CISA KEV and FIRST EPSS need no key.

# --- LLM ---
ANTHROPIC_API_KEY=
SENTINEL_PLANNER_MODEL=claude-opus-5
SENTINEL_BULK_MODEL=claude-haiku-4-5

# --- Ticket sinks (TicketSink adapters) ---
# Which sink the CLI writes to: github | jira | memory
SENTINEL_TICKET_SINK=github
SENTINEL_GITHUB_REPO=realme72/sentinel-ai
# gh CLI token is reused automatically if GITHUB_TOKEN is unset
GITHUB_TOKEN=
SENTINEL_JIRA_URL=
SENTINEL_JIRA_EMAIL=
SENTINEL_JIRA_TOKEN=
SENTINEL_JIRA_PROJECT=

# --- Embeddings (local, free) ---
SENTINEL_EMBED_MODEL=BAAI/bge-small-en-v1.5
SENTINEL_EMBED_DIM=384
